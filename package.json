{
  "name": "mandaoya",
  "version": "1.5.0",
  "private": true,
  "description": "MandaoYa: domicilios locales (PWA + app Android con Capacitor)",
  "scripts": {
    "build:www": "node scripts/build-www.mjs",
    "android:add": "node -e \"require('fs').existsSync('android')||require('child_process').execSync('npx cap add android',{stdio:'inherit'})\"",
    "android:assets": "npx capacitor-assets generate --android --iconBackgroundColor '#ea580c' --iconBackgroundColorDark '#ea580c' --splashBackgroundColor '#ea580c' --splashBackgroundColorDark '#ea580c'",
    "android:patch": "node scripts/patch-android.mjs",
    "android:prepare": "npm run build:www && npm run android:add && npm run android:assets && npm run android:patch && npx cap sync android",
    "android:apk": "npm run android:prepare && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "1.3.1",
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/push-notifications": "8.1.3"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.6.0"
  }
}
